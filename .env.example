# URL base da API (padrão: https://api.fruitvale.com.br)
VITE_API_URL=
# Host do broker MQTT mostrado nas credenciais dos sensores
VITE_MQTT_HOST=
# Chave da Map Tiles API do Google (satélite em alta resolução). Vazia = só as
# imagens da NASA. Restrinja a chave à Map Tiles API e ao domínio do site.
VITE_GOOGLE_MAPS_KEY=

# WhatsApp do botão "Contratar serviço" da landing: só dígitos, com DDI e DDD
VITE_WHATSAPP_NUMERO=

# Página /termos (LGPD): quem opera a plataforma e o contato para pedidos de titulares
VITE_CONTROLADOR_NOME=
VITE_CONTROLADOR_CNPJ=
VITE_CONTATO_PRIVACIDADE=
